# Copie ce fichier en ".env" et remplis les valeurs réelles (ne jamais commiter .env)

# Port du serveur en local
PORT=3001

# Origine autorisée pour CORS (mets l'URL exacte de ton frontend en prod)
ALLOWED_ORIGIN=*

# --- Supabase ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=colle-ta-clé-anon-ici
# ATTENTION : clé secrète, jamais exposée au frontend, jamais commitée sur GitHub
SUPABASE_SERVICE_ROLE_KEY=colle-ta-clé-service_role-ici

# --- Notifications email (optionnel — si laissé vide, les emails sont simplement désactivés) ---
# Fonctionne avec n'importe quel fournisseur SMTP : Gmail, Resend, Brevo, Mailgun...
# Exemple avec Resend (recommandé, simple, 3000 emails/mois gratuits) :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=ta-clé-api-resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="COLITRACK <no-reply@tondomaine.com>"

# URL publique de la page de suivi (utilisée dans les liens des emails)
PUBLIC_TRACK_URL=http://localhost:3001/track.html
